  "tooltip.starcatcher_delight.blossom_toast.0": "Un savoureux toast au goût de",
  "tooltip.starcatcher_delight.blossom_toast.1": "poisson, généralement préparé",
  "tooltip.starcatcher_delight.blossom_toast.2": "avec du poisson-fleur.",
  "tooltip.starcatcher_delight.blossom_toast.3": "Une seule bouchée suffit",
  "tooltip.starcatcher_delight.blossom_toast.4": "à vous remonter le moral,",
  "tooltip.starcatcher_delight.blossom_toast.5": "et à partager un peu de fantaisie",
  "tooltip.starcatcher_delight.blossom_toast.6": "cerisier avec votre entourage.",
  "tooltip.starcatcher_delight.cactifish_stew.0": "Un ragoût piquant préparé",
  "tooltip.starcatcher_delight.cactifish_stew.1": "avec un poisson-cactus.",
  "tooltip.starcatcher_delight.cactifish_stew.2": "Le poisson-cactus n’est pas",
  "tooltip.starcatcher_delight.cactifish_stew.3": "piquant, mais on s’attend à ce qu’un",
  "tooltip.starcatcher_delight.cactifish_stew.4": "ragoût qui en contient le soit,",
  "tooltip.starcatcher_delight.cactifish_stew.5": "alors on y ajoute généralement",
  "tooltip.starcatcher_delight.cactifish_stew.6": "un cactus pour le côté piquant.",
  "tooltip.starcatcher_delight.chocolate_taiyaki.0": "Un taiyaki fourré au chocolat,",
  "tooltip.starcatcher_delight.chocolate_taiyaki.1": "souvent offert aux enfants sages.",
  "tooltip.starcatcher_delight.fish_and_chips.0": "§7Une portion de fish and",
  "tooltip.starcatcher_delight.fish_and_chips.1": "chips de <Qualité inconnue>",
  "tooltip.starcatcher_delight.fish_and_chips_common.0": "Un plat grotesque, préparé par",
  "tooltip.starcatcher_delight.fish_and_chips_common.1": "ceux qui ne savent pas apprécier",
  "tooltip.starcatcher_delight.fish_and_chips_common.2": "la vraie cuisine de poisson.",
  "tooltip.starcatcher_delight.fish_and_chips_common.3": "Une insulte non seulement au",
  "tooltip.starcatcher_delight.fish_and_chips_common.4": "poisson, mais aussi à quiconque",
  "tooltip.starcatcher_delight.fish_and_chips_common.5": "sera forcé d’y goûter.",
  "tooltip.starcatcher_delight.fish_and_chips_epic.0": "Une démonstration de ce dont la cuisine de poisson est capable, même avec les ingrédients les plus simples.",
  "tooltip.starcatcher_delight.fish_and_chips_epic.2": "La saveur du poisson complète parfaitement le salé des frites, pour une combinaison faite au paradis.",
  "tooltip.starcatcher_delight.fish_and_chips_legendary.0": "Des filets de poisson panés,",
  "tooltip.starcatcher_delight.fish_and_chips_legendary.1": "frits à la perfection.",
  "tooltip.starcatcher_delight.fish_and_chips_legendary.2": "Des frites croustillantes",
  "tooltip.starcatcher_delight.fish_and_chips_legendary.3": "les accompagnent, pour une",
  "tooltip.starcatcher_delight.fish_and_chips_legendary.4": "combinaison miraculeuse.",
  "tooltip.starcatcher_delight.fish_and_chips_legendary.5": "Vous raclerez l’assiette",
  "tooltip.starcatcher_delight.fish_and_chips_legendary.6": "jusqu’à la dernière frite.",
  "tooltip.starcatcher_delight.fish_and_chips_rare.0": "Un filet de poisson servi avec des",
  "tooltip.starcatcher_delight.fish_and_chips_rare.1": "frites dorées et croustillantes.",
  "tooltip.starcatcher_delight.fish_and_chips_rare.2": "Tout simplement délicieux.",
  "tooltip.starcatcher_delight.fish_and_chips_uncommon.0": "Un plat typique des îles",
  "tooltip.starcatcher_delight.fish_and_chips_uncommon.1": "du nord de la surface,",
  "tooltip.starcatcher_delight.fish_and_chips_uncommon.2": "où le poisson et les pommes",
  "tooltip.starcatcher_delight.fish_and_chips_uncommon.3": "de terre abondent. Celui-ci",
  "tooltip.starcatcher_delight.fish_and_chips_uncommon.4": "est toutefois devenu mou.",
  "tooltip.starcatcher_delight.fish_and_chips_uncommon.5": "Le malheureux forcé de le",
  "tooltip.starcatcher_delight.fish_and_chips_uncommon.6": "manger devrait chercher",
  "tooltip.starcatcher_delight.fish_and_chips_uncommon.7": "mieux la prochaine fois.",
  "tooltip.starcatcher_delight.fish_salad.0": "§7Une salade de poisson",
  "tooltip.starcatcher_delight.fish_salad.1": "de <Qualité inconnue>",
  "tooltip.starcatcher_delight.fish_salad_common.0": "Une salade de poisson",
  "tooltip.starcatcher_delight.fish_salad_common.1": "décevante de fadeur.",
  "tooltip.starcatcher_delight.fish_salad_epic.0": "Une salade incroyablement bien",
  "tooltip.starcatcher_delight.fish_salad_epic.1": "habillée. On se demande où elle",
  "tooltip.starcatcher_delight.fish_salad_epic.2": "a trouvé ses vêtements.",
  "tooltip.starcatcher_delight.fish_salad_epic.3": "Quoi qu’il en soit, elle vous",
  "tooltip.starcatcher_delight.fish_salad_epic.4": "calera pour un bon moment.",
  "tooltip.starcatcher_delight.fish_salad_legendary.0": "La salade de poisson la",
  "tooltip.starcatcher_delight.fish_salad_legendary.1": "plus appétissante qu’il",
  "tooltip.starcatcher_delight.fish_salad_legendary.2": "vous ait été donné de voir.",
  "tooltip.starcatcher_delight.fish_salad_legendary.3": "Tout en elle est parfait, de la taille",
  "tooltip.starcatcher_delight.fish_salad_legendary.4": "de la portion à la présentation.",
  "tooltip.starcatcher_delight.fish_salad_legendary.5": "En la regardant, impossible de ne pas",
  "tooltip.starcatcher_delight.fish_salad_legendary.6": "saliver en rêvant d’une seule bouchée.",
  "tooltip.starcatcher_delight.fish_salad_legendary.7": "Dépêchez-vous avant",
  "tooltip.starcatcher_delight.fish_salad_legendary.8": "qu’il n’en reste plus !",
  "tooltip.starcatcher_delight.fish_salad_rare.0": "Une salade de poisson bien",
  "tooltip.starcatcher_delight.fish_salad_rare.1": "préparée. Elle ravit autant",
  "tooltip.starcatcher_delight.fish_salad_rare.2": "les yeux que l’estomac.",
  "tooltip.starcatcher_delight.fish_salad_uncommon.0": "Une salade de poisson bâclée, à",
  "tooltip.starcatcher_delight.fish_salad_uncommon.1": "l’image de la qualité du filet utilisé.",
  "tooltip.starcatcher_delight.glow_berry_taiyaki.0": "Cette friandise traditionnelle aux",
  "tooltip.starcatcher_delight.glow_berry_taiyaki.1": "baies lumineuses fraîches est souvent",
  "tooltip.starcatcher_delight.glow_berry_taiyaki.2": "consommée par les aventuriers avant",
  "tooltip.starcatcher_delight.glow_berry_taiyaki.3": "de plonger sous l’ardoise des abîmes.",
  "tooltip.starcatcher_delight.glow_berry_taiyaki.4": "Ses propriétés lumineuses permettent",
  "tooltip.starcatcher_delight.glow_berry_taiyaki.5": "aux autres de les repérer de loin.",
  "tooltip.starcatcher_delight.grilled_shroomfish.0": "Un poisson-champignon grillé,",
  "tooltip.starcatcher_delight.grilled_shroomfish.1": "servi avec des légumes verts et",
  "tooltip.starcatcher_delight.grilled_shroomfish.2": "de la purée de pommes de terre.",
  "tooltip.starcatcher_delight.grilled_shroomfish.3": "On raconte que la recette",
  "tooltip.starcatcher_delight.grilled_shroomfish.4": "vient de marins échoués",
  "tooltip.starcatcher_delight.grilled_shroomfish.5": "sur une île champignon,",
  "tooltip.starcatcher_delight.grilled_shroomfish.6": "qui n’avaient que des pommes",
  "tooltip.starcatcher_delight.grilled_shroomfish.7": "de terre et de la laitue à",
  "tooltip.starcatcher_delight.grilled_shroomfish.8": "manger pendant des mois.",
  "tooltip.starcatcher_delight.healthy_fish_omelette.0": "§7Une omelette de poisson",
  "tooltip.starcatcher_delight.healthy_fish_omelette.1": "santé de <Qualité inconnue>",
  "tooltip.starcatcher_delight.healthy_fish_omelette_common.0": "Des œufs crus, du poisson",
  "tooltip.starcatcher_delight.healthy_fish_omelette_common.1": "pas assez cuit et des légumes",
  "tooltip.starcatcher_delight.healthy_fish_omelette_common.2": "qui ont un goût de papier.",
  "tooltip.starcatcher_delight.healthy_fish_omelette_common.3": "Impossible de décrire à quel",
  "tooltip.starcatcher_delight.healthy_fish_omelette_common.4": "point cette tentative de",
  "tooltip.starcatcher_delight.healthy_fish_omelette_common.5": "nourriture est difficile à avaler.",
  "tooltip.starcatcher_delight.healthy_fish_omelette_epic.0": "Un plat qui mérite vraiment d’être",
  "tooltip.starcatcher_delight.healthy_fish_omelette_epic.1": "qualifié de sain, préparé avec du",
  "tooltip.starcatcher_delight.healthy_fish_omelette_epic.2": "poisson frais et des légumes,",
  "tooltip.starcatcher_delight.healthy_fish_omelette_epic.3": "avec des œufs cuits à la",
  "tooltip.starcatcher_delight.healthy_fish_omelette_epic.4": "perfection, servis avec des",
  "tooltip.starcatcher_delight.healthy_fish_omelette_epic.5": "légumes verts et de la tomate.",
  "tooltip.starcatcher_delight.healthy_fish_omelette_legendary.0": "Des œufs battus de manière",
  "tooltip.starcatcher_delight.healthy_fish_omelette_legendary.1": "uniforme et poêlés à mi-cuisson",
  "tooltip.starcatcher_delight.healthy_fish_omelette_legendary.10": "aussi incroyablement savoureux.",
  "tooltip.starcatcher_delight.healthy_fish_omelette_legendary.2": "vous donnent envie d’en",
  "tooltip.starcatcher_delight.healthy_fish_omelette_legendary.3": "manger avant même d’y goûter.",
  "tooltip.starcatcher_delight.healthy_fish_omelette_legendary.4": "On devine que le poisson utilisé était",
  "tooltip.starcatcher_delight.healthy_fish_omelette_legendary.5": "de grande qualité, car il répond",
  "tooltip.starcatcher_delight.healthy_fish_omelette_legendary.6": "parfaitement à vos attentes.",
  "tooltip.starcatcher_delight.healthy_fish_omelette_legendary.7": "Les légumes verts et la tomate",
  "tooltip.starcatcher_delight.healthy_fish_omelette_legendary.8": "s’accordent à merveille avec l’omelette,",
  "tooltip.starcatcher_delight.healthy_fish_omelette_legendary.9": "pour un plat non seulement sain, mais",
  "tooltip.starcatcher_delight.healthy_fish_omelette_rare.0": "Une savoureuse omelette préparée",
  "tooltip.starcatcher_delight.healthy_fish_omelette_rare.1": "avec des morceaux de poisson.",
  "tooltip.starcatcher_delight.healthy_fish_omelette_rare.2": "Une association originale, mais",
  "tooltip.starcatcher_delight.healthy_fish_omelette_rare.3": "tout s’accorde étonnamment bien.",
  "tooltip.starcatcher_delight.healthy_fish_omelette_uncommon.0": "Dire que c’est sain est",
  "tooltip.starcatcher_delight.healthy_fish_omelette_uncommon.1": "peut-être exagéré,",
  "tooltip.starcatcher_delight.healthy_fish_omelette_uncommon.2": "mais c’est un repas de bonne",
  "tooltip.starcatcher_delight.healthy_fish_omelette_uncommon.3": "taille qui vous calera un moment.",
  "tooltip.starcatcher_delight.honey_taiyaki.0": "Ce type de taiyaki est",
  "tooltip.starcatcher_delight.honey_taiyaki.1": "traditionnellement préparé",
  "tooltip.starcatcher_delight.honey_taiyaki.2": "par les apiculteurs,",
  "tooltip.starcatcher_delight.honey_taiyaki.3": "et offert en cadeau lorsqu’ils",
  "tooltip.starcatcher_delight.honey_taiyaki.4": "vendent leur miel aux voyageurs.",
  "tooltip.starcatcher_delight.hosomaki.0": "§7Un hosomaki de <Qualité inconnue>",
  "tooltip.starcatcher_delight.hosomaki_common.0": "Un essai d’hosomaki. Le",
  "tooltip.starcatcher_delight.hosomaki_common.1": "riz se répand partout",
  "tooltip.starcatcher_delight.hosomaki_common.2": "et le poisson sent comme",
  "tooltip.starcatcher_delight.hosomaki_common.3": "s’il avait tourné. Beurk.",
  "tooltip.starcatcher_delight.hosomaki_epic.0": "Un parfait exemple de la manière",
  "tooltip.starcatcher_delight.hosomaki_epic.1": "de préparer un sushi de qualité.",
  "tooltip.starcatcher_delight.hosomaki_epic.2": "Une seule bouchée vous plonge",
  "tooltip.starcatcher_delight.hosomaki_epic.3": "dans un monde de plaisir,",
  "tooltip.starcatcher_delight.hosomaki_epic.4": "et vous en redemandez jusqu’à ce",
  "tooltip.starcatcher_delight.hosomaki_epic.5": "que le rouleau entier ait disparu.",
  "tooltip.starcatcher_delight.hosomaki_legendary.0": "Un exemple époustouflant de",
  "tooltip.starcatcher_delight.hosomaki_legendary.1": "cuisine de poisson dont les autres",
  "tooltip.starcatcher_delight.hosomaki_legendary.2": "plats ne peuvent que rêver.",
  "tooltip.starcatcher_delight.hosomaki_legendary.3": "Ce sushi donnerait envie d’en",
  "tooltip.starcatcher_delight.hosomaki_legendary.4": "reprendre même aux plus difficiles.",
  "tooltip.starcatcher_delight.hosomaki_legendary.5": "Malheureusement pour eux,",
  "tooltip.starcatcher_delight.hosomaki_legendary.6": "il n’en restera plus une fois",
  "tooltip.starcatcher_delight.hosomaki_legendary.7": "que vous y aurez goûté.",
  "tooltip.starcatcher_delight.hosomaki_rare.0": "Un savoureux hosomaki,",
  "tooltip.starcatcher_delight.hosomaki_rare.1": "préparé avec du poisson frais.",
  "tooltip.starcatcher_delight.hosomaki_rare.2": "Un sushi de cette qualité est",
  "tooltip.starcatcher_delight.hosomaki_rare.3": "souvent considéré comme une",
  "tooltip.starcatcher_delight.hosomaki_rare.4": "gourmandise un peu luxueuse.",
  "tooltip.starcatcher_delight.hosomaki_uncommon.0": "Un hosomaki, tranché dans un rouleau.",
  "tooltip.starcatcher_delight.hosomaki_uncommon.1": "On peut seulement espérer que",
  "tooltip.starcatcher_delight.hosomaki_uncommon.2": "ce morceau a eu la pire partie",
  "tooltip.starcatcher_delight.hosomaki_uncommon.3": "du poisson, ce qui",
  "tooltip.starcatcher_delight.hosomaki_uncommon.4": "expliquerait son goût si fade.",
  "tooltip.starcatcher_delight.magma_fish_balls.0": "Une collation souvent préparée",
  "tooltip.starcatcher_delight.magma_fish_balls.1": "par les aventuriers qui partent",
  "tooltip.starcatcher_delight.magma_fish_balls.2": "explorer les profondeurs.",
  "tooltip.starcatcher_delight.magma_fish_balls.3": "Elles sont pénibles à préparer,",
  "tooltip.starcatcher_delight.magma_fish_balls.4": "mais elles sont si délicieuses",
  "tooltip.starcatcher_delight.magma_fish_balls.5": "que cela en vaut la peine !",
  "tooltip.starcatcher_delight.nigiri.0": "§7Un nigiri de <Qualité inconnue>",
  "tooltip.starcatcher_delight.nigiri_common.0": "Un nigiri répugnant. Il",
  "tooltip.starcatcher_delight.nigiri_common.1": "tient à peine ensemble.",
  "tooltip.starcatcher_delight.nigiri_common.2": "La couleur du poisson rend le",
  "tooltip.starcatcher_delight.nigiri_common.3": "tout absolument peu appétissant.",
  "tooltip.starcatcher_delight.nigiri_epic.0": "Un nigiri d’une présentation incroyable.",
  "tooltip.starcatcher_delight.nigiri_epic.1": "Non seulement le riz a l’air",
  "tooltip.starcatcher_delight.nigiri_epic.2": "extrêmement appétissant,",
  "tooltip.starcatcher_delight.nigiri_epic.3": "mais le soin apporté à la",
  "tooltip.starcatcher_delight.nigiri_epic.4": "présentation est remarquable, ce qui",
  "tooltip.starcatcher_delight.nigiri_epic.5": "rend la bouchée difficile à refuser.",
  "tooltip.starcatcher_delight.nigiri_legendary.0": "Bien que la préparation de ce",
  "tooltip.starcatcher_delight.nigiri_legendary.1": "type de sushi ne soit",
  "tooltip.starcatcher_delight.nigiri_legendary.2": "généralement pas sophistiquée,",
  "tooltip.starcatcher_delight.nigiri_legendary.3": "ce morceau remet en cause",
  "tooltip.starcatcher_delight.nigiri_legendary.4": "tout ce que vous saviez",
  "tooltip.starcatcher_delight.nigiri_legendary.5": "des sushis depuis toujours.",
  "tooltip.starcatcher_delight.nigiri_legendary.6": "Le poisson délicat a été soigneusement",
  "tooltip.starcatcher_delight.nigiri_legendary.7": "posé sur un riz cuit à la perfection.",
  "tooltip.starcatcher_delight.nigiri_legendary.8": "L’arôme qui s’en dégage vous met l’eau",
  "tooltip.starcatcher_delight.nigiri_legendary.9": "à la bouche et vous supplie d’y goûter.",
  "tooltip.starcatcher_delight.nigiri_rare.0": "Un nigiri bien préparé, fait de poisson",
  "tooltip.starcatcher_delight.nigiri_rare.1": "frais posé sur du riz moelleux.",
  "tooltip.starcatcher_delight.nigiri_rare.2": "Un vrai régal pour vos papilles.",
  "tooltip.starcatcher_delight.nigiri_uncommon.0": "Un essai de nigiri d’apprenti.",
  "tooltip.starcatcher_delight.nigiri_uncommon.1": "Même si le poisson ne semble",
  "tooltip.starcatcher_delight.nigiri_uncommon.2": "pas être de la meilleure qualité,",
  "tooltip.starcatcher_delight.nigiri_uncommon.3": "il fera office de collation au besoin.",
  "tooltip.starcatcher_delight.pumpkin_taiyaki.0": "Le type de taiyaki le plus courant.",
  "tooltip.starcatcher_delight.pumpkin_taiyaki.1": "Il est sucré et moelleux, parfait",
  "tooltip.starcatcher_delight.pumpkin_taiyaki.2": "pour qui cherche une gourmandise.",
  "tooltip.starcatcher_delight.sludge_stew.0": "Un ragoût peu ragoûtant d’aspect,",
  "tooltip.starcatcher_delight.sludge_stew.1": "mais étonnamment savoureux, préparé",
  "tooltip.starcatcher_delight.sludge_stew.2": "avec un poisson-chat vaseux.",
  "tooltip.starcatcher_delight.sludge_stew.3": "Un plat issu de la cuisine",
  "tooltip.starcatcher_delight.sludge_stew.4": "des villages des marais,",
  "tooltip.starcatcher_delight.sludge_stew.5": "souvent préparé avec ce",
  "tooltip.starcatcher_delight.sludge_stew.6": "qu’on avait sous la main.",
  "tooltip.starcatcher_delight.sludge_stew.7": "À déguster de préférence",
  "tooltip.starcatcher_delight.sludge_stew.8": "avec une cuillère en os.",
  "tooltip.starcatcher_delight.spore_nigiri.0": "Un nigiri unique, préparé avec",
  "tooltip.starcatcher_delight.spore_nigiri.1": "un poisson-spore frais (?).",
  "tooltip.starcatcher_delight.spore_nigiri.2": "L’odeur répugnante du poisson-spore",
  "tooltip.starcatcher_delight.spore_nigiri.3": "en fait un goût plutôt acquis.",
  "tooltip.starcatcher_delight.spore_nigiri.4": "Chaque bouchée vous rappelle",
  "tooltip.starcatcher_delight.spore_nigiri.5": "l’écosystème peu ragoûtant que",
  "tooltip.starcatcher_delight.spore_nigiri.6": "vous êtes en train de digérer.",
  "tooltip.starcatcher_delight.starcaught_fillet.0": "§7Un filet de poisson",
  "tooltip.starcatcher_delight.starcaught_fillet.1": "de <Qualité inconnue>",
  "tooltip.starcatcher_delight.starcaught_fillet_common.0": "Un filet de poisson cru qui sent comme",
  "tooltip.starcatcher_delight.starcaught_fillet_common.1": "s’il allait tourner d’ici trois heures.",
  "tooltip.starcatcher_delight.starcaught_fillet_epic.0": "Un filet de poisson d’une",
  "tooltip.starcatcher_delight.starcaught_fillet_epic.1": "qualité remarquable.",
  "tooltip.starcatcher_delight.starcaught_fillet_epic.2": "On ne peut qu’espérer",
  "tooltip.starcatcher_delight.starcaught_fillet_epic.3": "goûter l’incroyable création",
  "tooltip.starcatcher_delight.starcaught_fillet_epic.4": "pour laquelle il sera utilisé.",
  "tooltip.starcatcher_delight.starcaught_fillet_legendary.0": "Un filet de poisson",
  "tooltip.starcatcher_delight.starcaught_fillet_legendary.1": "incroyablement précieux, obtenu",
  "tooltip.starcatcher_delight.starcaught_fillet_legendary.2": "à partir d’un poisson <sclegendary>légendaire</sclegendary>.",
  "tooltip.starcatcher_delight.starcaught_fillet_legendary.3": "C’est dommage qu’il ait fini ainsi, mais",
  "tooltip.starcatcher_delight.starcaught_fillet_legendary.4": "impossible de ne pas se demander",
  "tooltip.starcatcher_delight.starcaught_fillet_legendary.5": "quel délicieux plat en préparer.",
  "tooltip.starcatcher_delight.starcaught_fillet_rare.0": "Un beau filet de poisson.",
  "tooltip.starcatcher_delight.starcaught_fillet_rare.1": "Quel que soit le plat auquel il",
  "tooltip.starcatcher_delight.starcaught_fillet_rare.2": "est destiné, il sera sans aucun",
  "tooltip.starcatcher_delight.starcaught_fillet_rare.3": "doute de grande qualité.",
  "tooltip.starcatcher_delight.starcaught_fillet_uncommon.0": "L’ingrédient principal de",
  "tooltip.starcatcher_delight.starcaught_fillet_uncommon.1": "la cuisine de poisson.",
  "tooltip.starcatcher_delight.steamed_redscaled_tuna.0": "Un thon aux écailles rouges",
  "tooltip.starcatcher_delight.steamed_redscaled_tuna.1": "cuit à la vapeur, qui vous",
  "tooltip.starcatcher_delight.steamed_redscaled_tuna.2": "donnera envie d’en reprendre.",
  "tooltip.starcatcher_delight.steamed_redscaled_tuna.3": "L’accompagnement de légumes",
  "tooltip.starcatcher_delight.steamed_redscaled_tuna.4": "verts s’accorde parfaitement",
  "tooltip.starcatcher_delight.steamed_redscaled_tuna.5": "avec la saveur du thon,",
  "tooltip.starcatcher_delight.steamed_redscaled_tuna.6": "pour un plat étonnamment savoureux.",
  "tooltip.starcatcher_delight.suspicious_taiyaki.0": "Un taiyaki en forme",
  "tooltip.starcatcher_delight.suspicious_taiyaki.1": "de... quelque chose...",
  "tooltip.starcatcher_delight.sweet_berry_taiyaki.0": "Un taiyaki fourré d’une pâte",
  "tooltip.starcatcher_delight.sweet_berry_taiyaki.1": "onctueuse de baies sucrées.",
  "tooltip.starcatcher_delight.temaki.0": "§7Un temaki de <Qualité inconnue>",
  "tooltip.starcatcher_delight.temaki_common.0": "Un temaki dégoûtant. Le riz",
  "tooltip.starcatcher_delight.temaki_common.1": "fait de son mieux pour",
  "tooltip.starcatcher_delight.temaki_common.2": "s’échapper du cône d’algue,",
  "tooltip.starcatcher_delight.temaki_common.3": "mais l’odeur du filet le retient,",
  "tooltip.starcatcher_delight.temaki_common.4": "on ne sait comment. Beurk.",
  "tooltip.starcatcher_delight.temaki_epic.0": "Un temaki exquis, réalisé avec",
  "tooltip.starcatcher_delight.temaki_epic.1": "un savoir-faire évident.",
  "tooltip.starcatcher_delight.temaki_epic.2": "L’algue est parfaitement",
  "tooltip.starcatcher_delight.temaki_epic.3": "roulée en cône,",
  "tooltip.starcatcher_delight.temaki_epic.4": "tandis que la garniture explose",
  "tooltip.starcatcher_delight.temaki_epic.5": "de saveurs riches qui persistent",
  "tooltip.starcatcher_delight.temaki_epic.6": "bien après la dernière bouchée.",
  "tooltip.starcatcher_delight.temaki_legendary.0": "Transcendant l’idée même",
  "tooltip.starcatcher_delight.temaki_legendary.1": "de simple nourriture,",
  "tooltip.starcatcher_delight.temaki_legendary.2": "chaque ingrédient a été choisi",
  "tooltip.starcatcher_delight.temaki_legendary.3": "avec une précision impossible,",
  "tooltip.starcatcher_delight.temaki_legendary.4": "pour s’harmoniser en un",
  "tooltip.starcatcher_delight.temaki_legendary.5": "chef-d’œuvre presque irréel.",
  "tooltip.starcatcher_delight.temaki_legendary.6": "Une bouchée suffit à vous convaincre",
  "tooltip.starcatcher_delight.temaki_legendary.7": "que la perfection existe vraiment.",
  "tooltip.starcatcher_delight.temaki_rare.0": "Un temaki soigneusement assemblé",
  "tooltip.starcatcher_delight.temaki_rare.1": "avec un poisson correct.",
  "tooltip.starcatcher_delight.temaki_rare.2": "Chaque bouchée offre un agréable",
  "tooltip.starcatcher_delight.temaki_rare.3": "équilibre de textures et de saveurs,",
  "tooltip.starcatcher_delight.temaki_rare.4": "pour une gourmandise",
  "tooltip.starcatcher_delight.temaki_rare.5": "étonnamment agréable.",
  "tooltip.starcatcher_delight.temaki_uncommon.0": "Un essai de temaki, manifestement",
  "tooltip.starcatcher_delight.temaki_uncommon.1": "réalisé par un cuisinier novice.",
  "tooltip.starcatcher_delight.temaki_uncommon.2": "Un poisson de mauvaise qualité",
  "tooltip.starcatcher_delight.temaki_uncommon.3": "donne un mauvais sushi. Il n’y",
  "tooltip.starcatcher_delight.temaki_uncommon.4": "a rien d’autre à dire.",
  "tooltip.starcatcher_delight.uramaki_common.0": "Un uramaki mal roulé.",
  "tooltip.starcatcher_delight.uramaki_common.1": "Le riz est sec et irrégulier,",
  "tooltip.starcatcher_delight.uramaki_common.2": "et la garniture reste à",
  "tooltip.starcatcher_delight.uramaki_common.3": "peine à l’intérieur assez",
  "tooltip.starcatcher_delight.uramaki_common.4": "longtemps pour être mangée.",
  "tooltip.starcatcher_delight.uramaki_epic.0": "Un uramaki magnifiquement réalisé,",
  "tooltip.starcatcher_delight.uramaki_epic.1": "qui témoigne d’un vrai talent.",
  "tooltip.starcatcher_delight.uramaki_epic.2": "Chaque grain de riz est",
  "tooltip.starcatcher_delight.uramaki_epic.3": "parfaitement assaisonné,",
  "tooltip.starcatcher_delight.uramaki_epic.4": "et rehausse les saveurs éclatantes",
  "tooltip.starcatcher_delight.uramaki_epic.5": "cachées dans le rouleau.",
  "tooltip.starcatcher_delight.uramaki_legendary.0": "Cet uramaki est un témoignage",
  "tooltip.starcatcher_delight.uramaki_legendary.1": "de maîtrise culinaire.",
  "tooltip.starcatcher_delight.uramaki_legendary.2": "Sa construction impeccable",
  "tooltip.starcatcher_delight.uramaki_legendary.3": "dissimule des couches de saveurs",
  "tooltip.starcatcher_delight.uramaki_legendary.4": "qui se dévoilent à chaque bouchée,",
  "tooltip.starcatcher_delight.uramaki_legendary.5": "chacune plus profonde",
  "tooltip.starcatcher_delight.uramaki_legendary.6": "que la précédente.",
  "tooltip.starcatcher_delight.uramaki_legendary.7": "Le manger ressemble moins à",
  "tooltip.starcatcher_delight.uramaki_legendary.8": "un repas qu’à une expérience",
  "tooltip.starcatcher_delight.uramaki_legendary.9": "à garder en mémoire.",
  "tooltip.starcatcher_delight.uramaki_rare.0": "Un uramaki joliment roulé, avec",
  "tooltip.starcatcher_delight.uramaki_rare.1": "un filet frais glissé à l’intérieur.",
  "tooltip.starcatcher_delight.uramaki_rare.2": "Le riz complète très bien le poisson,",
  "tooltip.starcatcher_delight.uramaki_rare.3": "pour une bouchée",
  "tooltip.starcatcher_delight.uramaki_rare.4": "satisfaisante et équilibrée.",
  "tooltip.starcatcher_delight.uramaki_uncommon.0": "Un essai passable d’uramaki",
  "tooltip.starcatcher_delight.uramaki_uncommon.1": "par une main inexpérimentée.",
  "tooltip.starcatcher_delight.uramaki_uncommon.2": "Le rouleau est correct,",
  "tooltip.starcatcher_delight.uramaki_uncommon.3": "quoiqu’un peu bâclé,",
  "tooltip.starcatcher_delight.uramaki_uncommon.4": "et même si les saveurs",
  "tooltip.starcatcher_delight.uramaki_uncommon.5": "sont ternes, il fait l’affaire.",
  "tooltip.starcatcher_delight.watermelon_taiyaki.0": "Très répandu dans les jungles,",
  "tooltip.starcatcher_delight.watermelon_taiyaki.1": "ce taiyaki est fourré d’une",
  "tooltip.starcatcher_delight.watermelon_taiyaki.2": "pâte de melon qui lui donne un",
  "tooltip.starcatcher_delight.watermelon_taiyaki.3": "goût très rafraîchissant.",
  "tooltip.starcatcher_delight.weather_soup.0": "Que cela vous plaise ou non, cette",
  "tooltip.starcatcher_delight.weather_soup.1": "soupe va faire un temps de chien...",
  "tooltip.starcatcher_delight.weather_soup.2": "ou plutôt, vous prendre d’assaut !"
}
