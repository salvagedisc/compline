{
  "multipart": [
    {
      "apply": {
        "model": "compline:block/cuve_a_tan"
      }
    },
    {
      "when": {
        "eau": "true",
        "tanin": "0"
      },
      "apply": {
        "model": "compline:block/cuve_a_tan_eau"
      }
    },
    {
      "when": {
        "eau": "true",
        "tanin": "1|2|3|4|5|6|7|8"
      },
      "apply": {
        "model": "compline:block/cuve_a_tan_tan"
      }
    },
    {
      "when": {
        "peaux": "1|2|3|4",
        "tannage": "0|1|2|3|4"
      },
      "apply": {
        "model": "compline:block/cuve_a_tan_peaux"
      }
    },
    {
      "when": {
        "peaux": "1|2|3|4",
        "tannage": "5"
      },
      "apply": {
        "model": "compline:block/cuve_a_tan_cuir"
      }
    }
  ]
}
