{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "compline:block/chevalet",
        "y": 0
      }
    },
    {
      "when": {
        "facing": "north",
        "peau": "true"
      },
      "apply": {
        "model": "compline:block/chevalet_peau",
        "y": 0
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "compline:block/chevalet",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "peau": "true"
      },
      "apply": {
        "model": "compline:block/chevalet_peau",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "compline:block/chevalet",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "south",
        "peau": "true"
      },
      "apply": {
        "model": "compline:block/chevalet_peau",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "compline:block/chevalet",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "peau": "true"
      },
      "apply": {
        "model": "compline:block/chevalet_peau",
        "y": 270
      }
    }
  ]
}
